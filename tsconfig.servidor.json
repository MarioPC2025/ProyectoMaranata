{
  // Código que corre en Cloudflare (Pages Functions)
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.servidor.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": ["functions/**/*.ts", "servidor/**/*.ts", "src/core/bible/usfm.ts"]
}
