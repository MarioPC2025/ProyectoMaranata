# Dependencies
node_modules/

# Build output
dist/
coverage/
*.tsbuildinfo

# Data: the upstream files (data/raw/) are committed; the datasets built from them are not, since
# `npm run dev` and `npm run build` rebuild them (see README.md → "Data").
public/data/*
# Except the Hebrew and Greek word by word (scripts/construir_original.py, which needs the STEPBible
# files that scripts/descargar.py downloads): the build does not make them, so they are kept.
!public/data/original/
!public/data/lexico/
!public/data/morfologia.json
!public/data/nombres.json.gz
# Except this one: 4.4 MB of archive for one translation is not worth keeping in the repository,
# so the build downloads it on demand and checks it against its pin in data/sources.json.
data/raw/eng-kjv2006_vpl.zip
# And these: 96 MB of tagged Hebrew and Greek, which STEPBible asks to be fetched from them
# rather than passed on second-hand. The build downloads them against their pins too.
data/raw/stepbible-*.txt

# The downloads of the Python scripts for the word-by-word data (scripts/descargar.py) live in
# folders of their own; only the files pinned in data/sources.json are kept loose in data/raw/.
data/raw/*/

# Cloudflare: wrangler's work files, and the local secrets of the proxy (see .dev.vars.example).
.wrangler/
.dev.vars

# Python
__pycache__/

# Test output: Playwright's traces, screenshots and report, and the Vitest cache.
test-results/
playwright-report/
.vitest/

# Logs
*.log
npm-debug.log*

# Local environment
*.local
.env
.env.*
# El de la app de Android no tiene secretos (ver el archivo).
!.env.android

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
